    <string name="about">About</string>
    <string name="privacy_on_device_title">Processed on this device</string>
    <string name="privacy_on_device_body">Android may deliver physical key events to %1$s through its Accessibility service. %1$s checks the key code and immediately ignores non-volume keys. For volume-up and volume-down, it temporarily processes the key code, press/release state, repeat count, event and down time, and input-device ID. It reads the active media output, volume range, and current volume through Android audio APIs, then changes media volume according to your curve or an explicit fixed-volume button tap. Your curve, fixed-volume buttons, long-press interval, and disclosure choice are stored only in the app’s private storage.</string>
    <string name="privacy_not_collected_title">Not collected or shared</string>
    <string name="privacy_not_collected_body">%1$s does not read screen content, touches, passwords, accounts, or personal files. It has no Internet permission and includes no advertising or analytics SDK. Key and volume data are not uploaded or shared.</string>
    <string name="privacy_retention_title">Control and deletion</string>
    <string name="privacy_retention_body">Turn off the main switch to stop mapping and consuming volume-button events, or disable the Accessibility service to stop their delivery to %1$s. Local settings remain until you clear the app’s storage or uninstall it; there is no server account or server-side data.</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_summary">Custom physical volume-button mapping for Android media audio.</string>
    <string name="about_compatibility">Available volume levels and background behavior depend on the phone firmware, output route, and connected audio device.</string>

