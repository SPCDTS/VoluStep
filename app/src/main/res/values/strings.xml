    <string name="accessibility_disclosure_title">Accessibility API disclosure</string>
    <string name="accessibility_disclosure_purpose">To detect physical volume buttons in other apps, on the Home screen, and on the lock screen, %1$s uses an Accessibility service. Android may deliver other physical key events to this service.</string>
    <string name="accessibility_disclosure_processed">%1$s checks each delivered key code and immediately passes through non-volume keys. For volume-up/down it temporarily uses the key code, press/release state, repeat count, event and down time, and input-device ID, then changes Android media volume.</string>
    <string name="accessibility_disclosure_not_processed">Not processed: screen text, window content, touches, passwords, or account data. %1$s does not upload key or volume data.</string>
    <string name="accessibility_disclosure_conflicts">Intercepting volume buttons may affect screenshots, accessibility shortcuts, and some manufacturer shortcuts. Turn off %1$s to restore default behavior.</string>
    <string name="accessibility_disclosure_consent">I understand the purpose and possible button conflicts, and agree to continue.</string>

